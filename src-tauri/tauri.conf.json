{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tally",
  "version": "1.0.0",
  "identifier": "com.victoriasanjurjo.tally",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tally — Generador de Presupuestos en PDF",
        "width": 1160,
        "height": 840,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CN=CF220D35-0C1C-408C-BCB2-E85AA65BC95B",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

